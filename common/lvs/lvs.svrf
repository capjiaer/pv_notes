VARIABLE POWERVAR "VDD"
VARIABLE GROUNDVAR "VSS"

LVS REPORT OPTION FX

LAYOUT PRIMARY "*"
LAYOUT PATH "test.gds"
LAYOUT SYSTEM GDSII

LVS ABORT ON SUPPLY ERROR NO

MASK SVDB DIRECTORY "svdb" QUERY CCI

DRC RESULTS DATABASE "drc.out" ASCII
DRC SUMMARY REPORT "drc.rpt"
ERC RESULTS DATABASE erc.db
DRC MAXIMUM RESULTS ALL
ERC MAXIMUM RESULTS ALL

LVS ISOLATE SHORTS YES

LAYER MAP 6 DATATYPE 1 33061
LAYER NWi 33061
LAYER MAP 10 DATATYPE 1 33100
LAYER PWi 33100
// PP AND NP
LAYER MAP 11 DATATYPE 1 33111
LAYER PPi 33111
LAYER MAP 12 DATATYPE 1 33121
LAYER NPi 33121
// OD is required
LAYER MAP 13 DATATYPE 1 33131
LAYER ODi 33131

// POLY
LAYER MAP 40 DATATYPE 1 33401
LAYER POi 33401
LAYER MAP 40 TEXTTYPE 6 33406
LAYER POtxt 33406
LAYER MAP 40 TEXTTYPE 9 33409
LAYER POpin 33409

// POLY CONNECT M0 BY VD
LAYER MAP 94 DATATYPE 1 39401
LAYER VDi 39401

//M0
LAYER MAP 92 DATATYPE 1 39101
LAYER M0i 39101
LAYER MAP 92 TEXTTYPE 6 39206
LAYER M0txt 39206
LAYER MAP 92 TEXTTYPE 9 39209
LAYER M0pin 39209

PORT LAYER TEXT M0pin
ATACH M0pin M0i
TEXT LAYER M0txt
ATTACH M0txt M0i
// CO for NWELL CONNECTION
LAYER MAP 93 DATATYPE 1 39931
LAYER COi 39931

pgate = ((POi AND NWi) AND PPi) AND ODi
ppoly = ((POi AND NWi) AND PPi) AND ODi
psd = ((ODi and PPi) AND NWi) NOT POi
nwell = COPY NWi

CONNECT POi M0i
CONNECT POi pgate
SCONNECT M0i psd
SCONNECT M0i nwell BY COi

DEVICE MP pgate ppoly(G) psd(S) psd(D) nwell(B)

//IGNORE LAYOUT TEXT DATABASE BUT get from include file
LAYOUT CELL LIST all "*"
LAYOUT IGNORE TEXT CELL LIST all DATABASE
// below is include file
LAYOUT TEXT hah -0.486 0.413 92 9 top
