#!/usr/bin/tclsh

# lef2spice.tcl -lef <lef_file>
proc main {argv} {
    # 默认参数
    set lef ""

    # 解析命令行参数
    for {set i 0} {$i < [llength $argv]} {incr i} {
        set arg [lindex $argv $i]
        switch -- $arg {
            "-lef" {
                set lef [lindex $argv [incr i]]
            }
            default {
                puts stderr "Unknown option: $arg"
                exit 1
            }
        }
    }

    # 检查必要参数
    if {$lef eq ""} {
        puts stderr "Usage: lef2spice -lef <lef_file>"
        exit 1
    }


    # 提取 lef 文件名（不带路径和后缀）
    set lef_basename [file rootname [file tail $lef]]
    set outfile "${lef_basename}.spice"

    set lef_file [open $lef r]
    set spice_file [open $outfile w]
    puts $spice_file "********************************************************************"
    puts $spice_file "*This file generated by lef2spice script, the spice file is empty subckt with PIN statement only"
    puts $spice_file "*This file works for LVS BLACK BOX if requried"
    puts $spice_file "*SOURCE LEF [file normalize $lef]"
    puts $spice_file ""
    puts $spice_file "*SPICE NETLIST"
    puts $spice_file "********************************************************************"
    # Get macro name
    set macro_info ""
    set macro_pin_list ""
    set macro_build 0
    while {[gets $lef_file ele] != -1} {
        puts $ele
        if {[regexp "^MACRO\\s+(\\w+)" $ele all_match macro_name]} {
            lappend macro_info $macro_name
            puts "Translate MACRO $macro_name"
            set macro_build 1
        }
        if {$macro_build} {
            if {[regexp "^\\s+PIN\\s+(\\S+)" $ele all_match pin_name]} {
                lappend macro_pin_list $pin_name
            }


            if {[regexp "^END\\s+$macro_name" $ele]} {
                puts "MACRO $macro_name Translate finished"
                set macro_pin_list [regsub -all {[{}]} $macro_pin_list ""]
                puts $spice_file ".SUBCKT $macro_name $macro_pin_list"
                puts $spice_file ".ENDS"
                puts $spice_file "********************************************************************"
                set macro_build 0
                set macro_pin_list ""
                set macro_info ""
            }
        }
    }

    puts "spice file generated: $outfile"
    close $spice_file
    close $lef_file
}

main $argv